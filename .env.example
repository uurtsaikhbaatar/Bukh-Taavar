# Хуулж `.env` болгоод утгуудыг тавина (.env git-д ордоггүй).
# Локал хөгжүүлэлтэд ЮУ Ч тохируулахгүй байж болно: JSONL лог + консол имэйл горим.

# Порт (анхдагч 8787)
PORT=8787

# Production: Neon Postgres (лог + бүртгэл). Байхгүй бол data/*.jsonl, data/web-auth.json
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Имэйл (баталгаажуулах/сэргээх код). Түлхүүр байхгүй бол консол горим.
# EMAIL_PROVIDER=brevo
# EMAIL_API_KEY=xkeysib-...
# EMAIL_FROM=Бөхийн таавар <noreply@yourdomain.mn>

# https-ийн ард (Render) cookie-г Secure болгоно
# SECURE_COOKIES=1

# devjee.mn: нийтийн Firebase web key (заавал биш — сайтаас өөрөө олдог); DEVJEE_DISABLED=1 бол холболтгүй
# DEVJEE_FIREBASE_KEY=
# DEVJEE_DISABLED=
